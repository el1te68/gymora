{
  "appId": "com.gymora.app",
  "appName": "Gymora",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f2f4fa"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    }
  }
}
